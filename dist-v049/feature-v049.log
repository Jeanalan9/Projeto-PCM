14:#details.active,#fiscal.active,#more.active{overflow-y:auto}.details-sticky{position:sticky;top:0;z-index:18;background:var(--bg);padding:0 0 8px;margin:0 0 2px}.details-sticky:after{content:"";position:absolute;left:0;right:0;bottom:0;height:10px;background:linear-gradient(to bottom,rgba(244,247,246,0),var(--bg));pointer-events:none}.details-sticky>.card{box-shadow:0 8px 20px rgba(31,55,48,.08)}.backline{display:flex;align-items:center;gap:7px;color:var(--green2);font-size:10px;font-weight:800;margin:0 0 7px;cursor:pointer}.details-hero{background:linear-gradient(145deg,var(--navy),var(--navy2));color:#fff;border-radius:18px;padding:13px;margin-bottom:8px}.details-hero .note-title{font-size:19px}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}.detail-cell{background:var(--surface2);border:1px solid var(--line);border-radius:12px;padding:9px}.detail-cell.full{grid-column:1/-1}.detail-cell label{display:block;font-size:8px;color:var(--muted);font-weight:800;margin-bottom:3px}.detail-cell b,.detail-cell span{font-size:10px;word-break:break-word}.details-section{margin-top:8px}.details-section .card{margin-top:0}.details-actions{display:grid;gap:7px;margin-top:8px}.status-options{display:grid;gap:6px}.status-option{border:1px solid var(--line);border-radius:11px;padding:9px;display:flex;align-items:center;gap:8px;font-size:10px;font-weight:800}.status-option.sel-ok{background:#e9f8f2;border-color:#8ed9c1;color:var(--ok)}.status-option.sel-wait{background:#fff7e7;border-color:#f0c877;color:var(--warn)}.status-option.sel-bad{background:#fff0ef;border-color:#efa49f;color:var(--bad)}
