MENTO',n.escaneadoEm||'—')+detailCell('DATA/HORA DA ENTREGA FISCAL',n.entregueFiscalEm||'—')+detailCell('ENTREGUE AO FISCAL',n.entregueFiscal?'Sim':'Não',true)+'</div>'+fiscalAction+'</div><div class="details-section card"><div class="panel-title">Histórico do controle fiscal</div>'+renderFiscalHistory(n.id)+'</div>'}
